# Copy to .env for local development. Never commit a real .env (constraint C3).
# Every value here is a non-identifying placeholder.

ENGINE_DATABASE_URL=postgresql://localhost:5432/scraping_engine
ENGINE_REDIS_URL=redis://localhost:6379/0

ENGINE_ENVIRONMENT=development
ENGINE_LOG_LEVEL=INFO

# Honest tier-0 identity. Point the contact URL at a real page in deployment.
ENGINE_USER_AGENT=SnoopScan (+https://snoopscan.com/bot)

# Pin the curl_cffi impersonation profile. Never float this — a floating
# profile changes our fingerprint (and block rates) on a library update.
ENGINE_IMPERSONATE_PROFILE=chrome124

# Fernet key for proxy credential encryption at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENGINE_ENCRYPTION_KEY=

# Shared secret for /internal, which the web app calls to mint keys and grant
# credits. The SAME value must be set as ENGINE_INTERNAL_TOKEN in the app's
# .env, or sign-ups get no credits and the desk cannot read the engine. It was
# set live and named in neither template (13 Sep 2026).
ENGINE_INTERNAL_TOKEN=

# Leave the SSRF guard on outside isolated test environments.
ENGINE_SSRF_GUARD_ENABLED=true


# ==========================================================================
# PROXIES
# ==========================================================================
# Off by default. With this false the engine goes direct and no proxy
# bandwidth can be spent, whatever else is configured below.
ENGINE_PROXY_ENABLED=false

# --- Residential ---------------------------------------------------------
# From your provider's dashboard: the rotating residential gateway's
# host:port and the proxy username/password (NOT your account login).
ENGINE_PROXY_RESIDENTIAL_HOST=
ENGINE_PROXY_RESIDENTIAL_PORT=
ENGINE_PROXY_USERNAME=
ENGINE_PROXY_PASSWORD=

# Default exit country, ISO 3166-1 alpha-2 (gb, us, de...). Leave blank for
# no geo pinning. Whatever you set here, the engine keeps Accept-Language and
# timezone coherent with it — a German exit IP sending en-US only is exactly
# the anomaly a WAF looks for.
ENGINE_PROXY_COUNTRY=us

# --- Datacenter (optional) ------------------------------------------------
# Cheaper per GB, higher detection risk. Fine for cooperative sites.
# Falls back to the residential username/password if these are blank.
ENGINE_PROXY_DATACENTER_HOST=
ENGINE_PROXY_DATACENTER_PORT=
ENGINE_PROXY_DATACENTER_USERNAME=
ENGINE_PROXY_DATACENTER_PASSWORD=

# --- Vendor credential format --------------------------------------------
# Residential vendors encode options (country, session) into the credentials,
# but disagree about WHICH field. Some append them to the PASSWORD and leave
# the username plain; others use the username, so both
# are templated and either style is a config edit rather than a code change.
#
# Placeholders: {username} {password} {country} {session} {lifetime}
# A segment with an empty value is dropped, so a blank country does not render
# as a dangling "_country-" (which the vendor rejects with 407, a symptom
# indistinguishable from a wrong password).
#
# The country must be the ISO 3166-1 alpha-2 code: gb, NOT uk.
ENGINE_PROXY_USERNAME_TEMPLATE={username}
ENGINE_PROXY_PASSWORD_TEMPLATE={password}_country-{country}
ENGINE_PROXY_PASSWORD_STICKY_TEMPLATE={password}_country-{country}_session-{session}_lifetime-{lifetime}m
ENGINE_PROXY_STICKY_LIFETIME_MINUTES=10

# --- Bandwidth budget -----------------------------------------------------
# THE cost control, and the reason you can leave this running unattended.
# Residential bandwidth is billed per GB. At 80% of a cap the engine warns;
# at 100% it REFUSES further proxied requests and carries on direct where
# policy allows. Spend is measured from real transferred bytes, not estimated.
#
# Start these low. 500MB/day of residential is a lot of HTML once images,
# fonts and stylesheets are blocked at the browser tier.
ENGINE_PROXY_DAILY_BUDGET_MB=500
ENGINE_PROXY_MONTHLY_BUDGET_MB=10000
ENGINE_PROXY_BUDGET_WARN_FRACTION=0.8

# Refuse any single response larger than this, so one enormous asset cannot
# eat the day's allowance.
ENGINE_PROXY_MAX_RESPONSE_MB=25

# --- Structured extraction model -------------------------------------------
# /v1/extract answers from structured markup for free; when a schema needs
# more, a model fills it in — only if this key is set. The SDK reads it as-is.
ANTHROPIC_API_KEY=
ENGINE_EXTRACT_MODEL=claude-opus-5
ENGINE_EXTRACT_EFFORT=medium

# Search. Empty means DuckDuckGo, which needs no key. 'serper' + a key buys Google results; 'none' switches search off.
ENGINE_SEARCH_PROVIDER=
ENGINE_SEARCH_API_KEY=

# A self-hosted SearXNG for the first rung of the search ladder. Empty disables it.
ENGINE_SEARXNG_URL=
ENGINE_SEARCH_LADDER=searxng,duckduckgo
# Scrapingdog Google Search API — the bought rung. Empty disables it.
ENGINE_SCRAPINGDOG_KEY=

# --- Google results pages (/v1/serp) ----------------------------------------
# Rankings and the AI Overview, per country, from DataForSEO's live SERP API.
# The API login and password from app.dataforseo.com/api-access (not your
# account login). Both empty: /v1/serp answers 503 and nothing is charged.
ENGINE_DATAFORSEO_LOGIN=
ENGINE_DATAFORSEO_PASSWORD=
